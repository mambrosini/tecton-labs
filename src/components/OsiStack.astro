---
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

// Base colors for inactive state (blueish-grey)
const INACTIVE = { top: '#1c2130', left: '#10141f', right: '#0b0f17', stroke: 'rgba(255,255,255,0.1)' };

const layers = t.services.layers.map((layer) => ({ ...layer, colors: INACTIVE }));

// ── Isometric geometry ────────────────────────────────────────────────────────
const CX = 180;       // front-center anchor X
const BASE_Y = 320;   // front-bottom Y of layer 0
const W_DX = 150, W_DY = -75; // Right edge (goes up-right)
const D_DX = -150, D_DY = -75; // Left edge (goes up-left)
const LAYER_H = 26;
const STEP = 48;

function pts(points: [number, number][]): string {
	return points.map(([x, y]) => `${x},${y}`).join(' ');
}

function layerGeom(i: number) {
	const by = BASE_Y - i * STEP; // bottom-front corner Y
	const ty = by - LAYER_H;      // top-front corner Y
	
	// Right corner of the layer
	const rx = CX + W_DX;
	const ry = ty + W_DY + (LAYER_H / 2);
	
	return {
		top: pts([
			[CX, ty],
			[CX + W_DX, ty + W_DY],
			[CX + W_DX + D_DX, ty + W_DY + D_DY],
			[CX + D_DX, ty + D_DY],
		]),
		left: pts([
			[CX, ty],
			[CX + D_DX, ty + D_DY],
			[CX + D_DX, by + D_DY],
			[CX, by],
		]),
		right: pts([
			[CX, ty],
			[CX + W_DX, ty + W_DY],
			[CX + W_DX, by + W_DY],
			[CX, by],
		]),
		outline: pts([
			[CX + W_DX + D_DX, ty + W_DY + D_DY],
			[CX + W_DX, ty + W_DY],
			[CX + W_DX, by + W_DY],
			[CX, by],
			[CX + D_DX, by + D_DY],
			[CX + D_DX, ty + D_DY],
		]),
		rx,
		ry,
	};
}
---

<div class="grid lg:grid-cols-[1.2fr_1fr] lg:gap-24 items-center">
	
	<!-- Left Column: Header + SVG -->
	<div class="flex flex-col relative">
		<!-- Section Header -->
		<div class="mb-12 relative z-10">
			<div class="flex items-center gap-4 mb-6">
				<span class="text-xs font-bold tracking-widest text-gray-400 uppercase">{t.services.eyebrow}</span>
				<div class="h-px w-16 bg-white/20"></div>
			</div>
			<h2 class="text-4xl font-bold text-white sm:text-5xl leading-tight">
				{t.services.title}
			</h2>
			<p class="mt-6 text-lg text-gray-400 max-w-md">
				{t.services.subtitle}
			</p>
		</div>

		<!-- Isometric SVG Stack -->
		<svg
			viewBox="-20 0 550 400"
			class="w-full max-w-[600px] h-auto overflow-visible mx-auto lg:mx-0 lg:-ml-10"
			aria-hidden="true"
			focusable="false"
		>
			<!-- Background Grid Base (optional styling) -->
			<g stroke="rgba(255,255,255,0.03)" stroke-width="1">
				<line x1={CX} y1={BASE_Y + 40} x2={CX + 200} y2={BASE_Y + 40 - 100} />
				<line x1={CX} y1={BASE_Y + 40} x2={CX - 200} y2={BASE_Y + 40 - 100} />
				<line x1={CX - 50} y1={BASE_Y + 40 - 25} x2={CX - 50 + 200} y2={BASE_Y + 40 - 25 - 100} />
				<line x1={CX + 50} y1={BASE_Y + 40 - 25} x2={CX + 50 - 200} y2={BASE_Y + 40 - 25 - 100} />
			</g>

			{layers.map((layer, i) => {
				const g = layerGeom(i);
				// The initial active layer
				const isActive = false;
				const fillTop = isActive ? '#c25a1b' : layer.colors.top;
				const fillLeft = isActive ? '#8c3c0d' : layer.colors.left;
				const fillRight = isActive ? '#5e2506' : layer.colors.right;
				const strokeC = isActive ? 'rgba(249,115,22,0.8)' : layer.colors.stroke;
				const lineOpacity = isActive ? '0.6' : '0.2';
				const textOpacity = isActive ? '1' : '0.4';

				return (
					<g class="osi-layer-container" data-layer={String(i)}>
						<g
							class="osi-layer-visuals"
							style="transition:transform 300ms cubic-bezier(0.4, 0, 0.2, 1); pointer-events:none;"
						>
							<polygon
								class="face-left"
								points={g.left}
								fill={fillLeft}
								stroke={strokeC}
								stroke-width="0.5"
								style="transition: all 300ms ease;"
							/>
							<polygon
								class="face-right"
								points={g.right}
								fill={fillRight}
								stroke={strokeC}
								stroke-width="0.5"
								style="transition: all 300ms ease;"
							/>
							<polygon
								class="face-top"
								points={g.top}
								fill={fillTop}
								stroke={strokeC}
								stroke-width={isActive ? "1" : "0.5"}
								style="transition: all 300ms ease;"
							/>
							
							<!-- Connector Line & Label -->
							<circle 
								class="connector-dot"
								cx={g.rx + 10} 
								cy={g.ry} 
								r="2.5" 
								fill="white" 
								opacity={lineOpacity}
								style="transition: opacity 300ms ease;"
							/>
							<line 
								class="connector-line"
								x1={g.rx + 10} 
								y1={g.ry} 
								x2={g.rx + 60} 
								y2={g.ry} 
								stroke="white" 
								stroke-width="1"
								opacity={lineOpacity}
								style="transition: opacity 300ms ease;"
							/>
							<text 
								class="connector-text"
								x={g.rx + 75} 
								y={g.ry + 4} 
								fill={isActive ? '#f97316' : '#9ca3af'}
								font-family="system-ui, sans-serif" 
								font-size="11" 
								font-weight="700" 
								letter-spacing="0.1em"
								opacity={textOpacity}
								style="transition: all 300ms ease;"
							>
								{layer.label.toUpperCase()}
							</text>
						</g>
						<polygon
							class="face-hitbox"
							points={g.outline}
							fill="transparent"
							style="cursor:pointer;"
						/>
					</g>
				);
			})}
		</svg>
	</div>

	<!-- Right Column: Interactive List -->
	<div class="relative" id="osi-list">
		<ol class="flex flex-col-reverse">
			{layers.map((layer, i) => {
				const isActive = false;
				return (
					<li
						class="osi-item relative group cursor-pointer"
						data-layer={String(i)}
					>
						<!-- Left border highlight -->
						<div class={`absolute left-0 top-0 bottom-0 w-[2px] transition-colors duration-300 ${isActive ? 'bg-brand-500' : 'bg-transparent group-hover:bg-brand-500/30'}`}></div>
						
						<!-- Top border separator (not on the topmost layer) -->
						{i < layers.length - 1 && <div class="absolute left-6 right-0 top-0 h-px bg-white/10"></div>}

						<div class="osi-item-content pl-6 pr-4 py-4 transition-all duration-300 ease-in-out opacity-100">
							<div>
								<span class={`font-mono block text-[11px] font-bold uppercase tracking-[0.2em] transition-colors duration-300 ${isActive ? 'text-brand-500' : 'text-gray-500'}`}>
									{layer.label}
								</span>
								<h3 class="mt-1 font-bold text-white text-xl tracking-tight">{layer.title}</h3>
								<p class="mt-1.5 text-sm leading-relaxed text-gray-400 max-w-sm">{layer.description}</p>
								
								<!-- Tech Tags -->
								<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] font-bold tracking-widest text-gray-500 uppercase">
									{layer.tags.map((tag, idx) => (
										<>
											<span class={isActive ? 'text-gray-400' : ''}>{tag}</span>
											{idx < layer.tags.length - 1 && <span class="text-white/20">/</span>}
										</>
									))}
								</div>
							</div>
						</div>
					</li>
				);
			})}
		</ol>
		<p class="mt-8 pl-6 font-mono text-xs text-gray-500">{t.services.closing}</p>
	</div>
</div>

<script>
	// Colors for active/hover state
	const ACTIVE = { top: '#c25a1b', left: '#8c3c0d', right: '#5e2506', stroke: 'rgba(255,255,255,0.2)' };
	// Colors for inactive state
	const INACTIVE = { top: '#1c2130', left: '#10141f', right: '#0b0f17', stroke: 'rgba(255,255,255,0.2)' };

	const containers = document.querySelectorAll<SVGGElement>('.osi-layer-container');
	const items = document.querySelectorAll<HTMLElement>('.osi-item');
	const section = document.getElementById('osi-container'); // Need to wrap the component or add ID to the grid

	// Start with no layer active
	let activeIndex: number | null = null;

	function updateList(idx: number | null) {
		items.forEach((item) => {
			const itemIdx = parseInt(item.dataset.layer ?? '-1', 10);
			const content = item.querySelector<HTMLElement>('.osi-item-content')!;
			const number = item.querySelector<HTMLElement>('span.font-mono')!;
			const border = item.querySelector<HTMLElement>('.absolute.w-\\[2px\\]')!;
			const tags = item.querySelectorAll<HTMLElement>('.text-\\[10px\\] span:not(.text-white\\/20)');

			if (idx === null) {
				// Default state (no hover)
				content.classList.remove('opacity-40');
				content.classList.add('opacity-100');
				number.classList.remove('text-brand-500');
				number.classList.add('text-gray-500');
				border.classList.remove('bg-brand-500');
				border.classList.add('bg-transparent');
				tags.forEach(t => t.classList.remove('text-gray-400'));
			} else if (itemIdx === idx) {
				// Active
				content.classList.remove('opacity-40');
				content.classList.add('opacity-100');
				number.classList.remove('text-gray-500');
				number.classList.add('text-brand-500');
				border.classList.remove('bg-transparent');
				border.classList.add('bg-brand-500');
				tags.forEach(t => t.classList.add('text-gray-400'));
			} else {
				// Inactive (dimmed)
				content.classList.remove('opacity-100');
				content.classList.add('opacity-40');
				number.classList.remove('text-brand-500');
				number.classList.add('text-gray-500');
				border.classList.remove('bg-brand-500');
				border.classList.add('bg-transparent');
				tags.forEach(t => t.classList.remove('text-gray-400'));
			}
		});
	}

	function updateSvg(idx: number | null) {
		containers.forEach((container) => {
			const containerIdx = parseInt(container.dataset.layer ?? '-1', 10);
			const visuals = container.querySelector<SVGGElement>('.osi-layer-visuals')!;
			const top = visuals.querySelector<SVGPolygonElement>('.face-top')!;
			const left = visuals.querySelector<SVGPolygonElement>('.face-left')!;
			const right = visuals.querySelector<SVGPolygonElement>('.face-right')!;
			
			const dot = visuals.querySelector<SVGCircleElement>('.connector-dot')!;
			const line = visuals.querySelector<SVGLineElement>('.connector-line')!;
			const text = visuals.querySelector<SVGTextElement>('.connector-text')!;

			if (containerIdx === idx) {
				// Active
				top.setAttribute('fill', ACTIVE.top);
				top.setAttribute('stroke', ACTIVE.stroke);
				top.setAttribute('stroke-width', '1');
				left.setAttribute('fill', ACTIVE.left);
				right.setAttribute('fill', ACTIVE.right);
				
				visuals.style.transform = 'translateY(-7px)';
				
				dot.setAttribute('opacity', '0.6');
				line.setAttribute('opacity', '0.6');
				text.setAttribute('opacity', '1');
				text.setAttribute('fill', '#f97316'); // brand-500
			} else {
				// Inactive or Default
				top.setAttribute('fill', INACTIVE.top);
				top.setAttribute('stroke', INACTIVE.stroke);
				top.setAttribute('stroke-width', '0.5');
				left.setAttribute('fill', INACTIVE.left);
				right.setAttribute('fill', INACTIVE.right);
				
				visuals.style.transform = '';

				if (idx === null) {
					// Default state (all visible but dimmed)
					dot.setAttribute('opacity', '0.2');
					line.setAttribute('opacity', '0.2');
					text.setAttribute('opacity', '0.4');
					text.setAttribute('fill', '#9ca3af'); // gray-400
				} else {
					// Another layer is active
					dot.setAttribute('opacity', '0.2');
					line.setAttribute('opacity', '0.2');
					text.setAttribute('opacity', '0.4');
					text.setAttribute('fill', '#9ca3af'); // gray-400
				}
			}
		});
	}

	function activate(idx: number | null) {
		if (activeIndex === idx) return;
		activeIndex = idx;
		updateList(idx);
		updateSvg(idx);
	}

	containers.forEach((container) => {
		container.addEventListener('mouseenter', () => {
			const idx = parseInt(container.dataset.layer ?? '-1', 10);
			activate(idx);
		});
	});
	
	items.forEach((item) => {
		item.addEventListener('mouseenter', () => {
			const idx = parseInt(item.dataset.layer ?? '-1', 10);
			activate(idx);
		});
	});

	// Reset to default state when mouse leaves the whole section
	// or moves over non-interactive parts (like the title)
	const grid = document.querySelector('.grid.lg\\:grid-cols-\\[1\\.2fr_1fr\\]');
	if (grid) {
		grid.addEventListener('mouseleave', () => {
			activate(null);
		});
		
		grid.addEventListener('mousemove', (e) => {
			const target = e.target as Element;
			const isInteractive = target.closest('.osi-layer-container, .osi-item');
			if (!isInteractive && activeIndex !== null) {
				activate(null);
			}
		});
	}

	// Initialize default state
	updateList(null);
	updateSvg(null);
</script>
