---
const navLinks = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#nosotros', label: 'Nosotros' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-950/80 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
		<a href="/" class="flex items-center" aria-label="Tecton Labs">
			<img src="/logo_white_small.png" alt="Tecton Labs" class="h-5 w-auto sm:h-6" />
		</a>
		<nav class="hidden gap-8 text-sm font-medium text-gray-300 sm:flex">
			{navLinks.map((link) => (
				<a href={link.href} class="transition hover:text-white">{link.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-2">
			<a
				href="#contacto"
				class="hidden rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-500 sm:inline-block"
			>
				Hablemos
			</a>
			<button
				id="menu-toggle"
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-nav"
				class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white sm:hidden"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>
	<nav
		id="mobile-nav"
		class="hidden flex-col gap-1 border-t border-white/10 bg-ink-950 px-6 py-4 text-sm font-medium text-gray-300 sm:hidden"
	>
		{navLinks.map((link) => (
			<a href={link.href} class="rounded-lg px-2 py-3 transition hover:bg-white/5 hover:text-white">{link.label}</a>
		))}
		<a href="#contacto" class="mt-2 rounded-full bg-brand-600 px-4 py-3 text-center font-semibold text-white transition hover:bg-brand-500">
			Hablemos
		</a>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('mobile-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('flex');
		nav?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	nav?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).tagName === 'A') {
			nav.classList.add('hidden');
			nav.classList.remove('flex');
			toggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>
