---
import { defaultLocale, localePath, locales, useTranslations, type Locale } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const currentLocale = (Astro.currentLocale ?? defaultLocale) as Locale;

const navLinks = [
	{ href: '#servicios', label: t.nav.services },
	{ href: '#como-trabajamos', label: t.nav.process },
	{ href: '#experiencia', label: t.nav.experience },
	{ href: '#nosotros', label: t.nav.about },
	{ href: '#contacto', label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-950/80 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3">
		<a href={localePath(currentLocale)} class="flex items-center gap-3 sm:gap-3" aria-label="Tecton Labs">
			<img src="/tecton_logo_badge_white_transparency_small.png" alt="Tecton" class="h-6 w-auto sm:h-7" />
			<img src="/logo_white_stroke_small_header_full.png" alt="Tecton Labs" class="h-3.5 w-auto sm:h-4" />
		</a>
		<nav class="hidden gap-6 text-sm font-medium text-gray-300 md:flex lg:gap-8">
			{navLinks.map((link) => (
				<a href={link.href} class="transition hover:text-white">{link.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-2">
			<nav aria-label={t.nav.language} class="flex items-center rounded-full border border-white/15 p-0.5 text-xs font-semibold">
				{locales.map((locale) => (
					<a
						href={localePath(locale)}
						hreflang={locale}
						lang={locale}
						data-locale={locale}
						aria-current={locale === currentLocale ? 'true' : undefined}
						class:list={[
							'rounded-full px-2.5 py-1 uppercase transition',
							locale === currentLocale ? 'bg-white/10 text-white' : 'text-gray-400 hover:text-white',
						]}
					>
						{locale}
					</a>
				))}
			</nav>
			<a
				href="#contacto"
				class="hidden rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95 md:inline-block"
			>
				{t.nav.cta}
			</a>
			<button
				id="menu-toggle"
				type="button"
				aria-label={t.nav.openMenu}
				aria-expanded="false"
				aria-controls="mobile-nav"
				class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white md:hidden"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>
	<nav
		id="mobile-nav"
		class="absolute left-0 right-0 top-full flex flex-col gap-1 border-t border-white/10 bg-ink-950 px-6 py-4 text-sm font-medium text-gray-300 shadow-2xl transition-all duration-300 md:hidden opacity-0 -translate-y-2 pointer-events-none [&.is-open]:opacity-100 [&.is-open]:translate-y-0 [&.is-open]:pointer-events-auto"
	>
		{navLinks.map((link) => (
			<a href={link.href} class="rounded-lg px-2 py-3 transition hover:bg-white/5 hover:text-white">{link.label}</a>
		))}
		<a href="#contacto" class="mt-2 rounded-full bg-brand-600 px-4 py-3 text-center font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95">
			{t.nav.cta}
		</a>
	</nav>
</header>

<script>
	import { localeStorageKey } from '../i18n/preference';

	// Elegir idioma a mano gana sobre la detección automática (ver Layout.astro).
	document.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((link) => {
		link.addEventListener('click', () => {
			try {
				localStorage.setItem(localeStorageKey, link.dataset.locale ?? '');
			} catch {}
			link.href += location.hash;
		});
	});

	const toggle = document.getElementById('menu-toggle');
	const nav = document.getElementById('mobile-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	nav?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).tagName === 'A') {
			nav.classList.remove('is-open');
			toggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>
