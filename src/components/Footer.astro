---
import { contact } from '../data/contact';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-10 text-sm text-gray-400 sm:flex-row sm:justify-between">
		<div class="flex flex-col items-center gap-4 sm:items-start">
			<a href="/" class="flex items-center gap-3 sm:gap-3" aria-label="Tecton Labs">
				<img src="/tecton_logo_badge_white_transparency_small.png" alt="Tecton" class="h-6 w-auto sm:h-7" />
				<img src="/logo_white_stroke_small_header_full.png" alt="Tecton Labs" class="h-3.5 w-auto sm:h-4" />
			</a>
			<p>&copy; {year} Tecton Labs · {contact.location}</p>
		</div>
		<div class="flex flex-wrap justify-center gap-6">
			<a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a>
			<a href={contact.whatsapp.url} target="_blank" rel="noopener" class="hover:text-white">WhatsApp</a>
			<a href="#servicios" class="hover:text-white">Servicios</a>
			<a href="#contacto" class="hover:text-white">Contacto</a>
		</div>
	</div>
</footer>
