---
import { contact } from '../data/contact';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<!-- Solo en mobile: en desktop WhatsApp está en Contacto y el footer. -->
<a
	href={contact.whatsapp.url(t.contact.whatsappMessage)}
	target="_blank"
	rel="noopener"
	aria-label={t.footer.whatsappButton}
	title={t.footer.whatsappButton}
	class="fixed bottom-4 right-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg shadow-black/40 transition hover:scale-105 active:scale-95 md:hidden"
>
	<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
	</svg>
</a>
