---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import ShaderBackground from '../components/ShaderBackground.astro';
import DecodeHeading from '../components/DecodeHeading.astro';
import OsiStack from '../components/OsiStack.astro';
---

<Layout>
    <section class="relative overflow-hidden">
        <ShaderBackground />
        <div class="absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/70 to-ink-950"></div>
        <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-24 text-center sm:pt-28">
            <div class="mx-auto mb-8 flex items-center justify-center gap-4 sm:gap-6">
                <img src="/tecton_logo_badge_white_transparency.png" alt="Tecton" class="h-16 w-auto sm:h-24" />
                <img src="/logo_white_stroke_small.png" alt="Tecton Labs" class="h-8 w-auto sm:h-15" />
            </div>
            <DecodeHeading
                id="hero-heading"
                text="De problemas complejos a software simple"
                class="mx-auto max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-6xl"
            />
            <p class="mx-auto mt-6 max-w-2xl text-base text-gray-400 sm:text-lg">
                Diseñamos y construimos software robusto para empresas que necesitan avanzar rápido sin sacrificar calidad.
            </p>
            <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
                <a
                    href="#contacto"
                    class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95"
                >
                    Empecemos un proyecto
                </a>
                <a
                    href="#servicios"
                    class="rounded-full border border-white/15 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/40 active:scale-95"
                >
                    Ver servicios
                </a>
            </div>
        </div>
    </section>

    <section id="servicios" class="border-t border-white/10 bg-white/[0.02] py-24">
        <div class="mx-auto max-w-6xl px-6">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">Servicios</h2>
            <p class="mt-3 max-w-2xl text-gray-400">
                Un equipo multidisciplinario cubriendo todo el ciclo de vida de tu producto, desde la idea hasta la operación.
            </p>
            <div class="mt-16">
                <OsiStack />
            </div>
        </div>
    </section>

    <section id="nosotros" class="py-24">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:grid-cols-2 sm:items-center">
            <div>
                <h2 class="text-3xl font-bold text-white sm:text-4xl">Nosotros</h2>
                <p class="mt-4 text-gray-400">
                    Tecton Labs nació para ayudar a empresas de todos los tamaños a resolver sus desafíos tecnológicos con soluciones pensadas a medida, no con productos genéricos.
                </p>
                <p class="mt-4 text-gray-400">
                    Trabajamos como una extensión de tu equipo: comunicación directa, entregas frecuentes y compromiso con resultados medibles.
                </p>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:gap-6">
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">&lt; 1 mes</p>
                    <p class="mt-1 text-sm text-gray-400">Para tu primer MVP</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">+10</p>
                    <p class="mt-1 text-sm text-gray-400">Años de experiencia</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">24/7</p>
                    <p class="mt-1 text-sm text-gray-400">Soporte para clientes activos</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">100%</p>
                    <p class="mt-1 text-sm text-gray-400">Foco en resultados</p>
                </div>
            </div>
        </div>
    </section>

	

    <!-- Considera agregar un testimonio o caso de estudio aquí -->
     <section id="experiencia" class="border-t border-white/10 bg-white/[0.02] py-24">
        <div class="mx-auto max-w-6xl px-6 text-center">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">Nuestra Trayectoria</h2>
            <p class="mt-6 max-w-3xl mx-auto text-gray-400">
                A lo largo de los años, hemos construido soluciones y colaborado con organizaciones de primer nivel.
            </p>

            <div class="mt-12 flex gap-6 flex-wrap justify-center items-center">
                <img src="/client-logo1.png" alt="Client Logo 1" class="h-32 w-auto object-contain" />
                <img src="/client-logo2.png" alt="Client Logo 2" class="h-32 w-auto object-contain" />
                <img src="/client-logo3.png" alt="Client Logo 3" class="h-32 w-auto object-contain" />
                <!-- Add more client logos as needed -->

            </div>

        </div>
    </section>

    <section id="contacto" class="py-24">
        <div class="mx-auto max-w-2xl px-6 text-center">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">Hablemos de tu proyecto</h2>
            <p class="mt-3 text-gray-400">
                Contanos qué necesitás y te respondemos con una propuesta a la brevedad.
            </p>
            <div class="mt-10 text-left">
                <ContactForm client:load />
            </div>
        </div>
    </section>

    <!-- Incluir enlace al mapa del sitio -->
    <footer class="py-6 border-t border-white/10 bg-white/[0.02]">
        <div class="mx-auto max-w-6xl px-6 text-center">
            <p>© 2026 Tecton Labs. Todos los derechos reservados.</p>
            <nav class="mt-4">
                <a href="#contacto" class="text-gray-400 hover:text-white">Contacto</a>
                <span class="mx-3 text-gray-400">|</span>
                <a href="/terms" class="text-gray-400 hover:text-white">Términos y Condiciones</a>
            </nav>
        </div>
    </footer>
</Layout>
