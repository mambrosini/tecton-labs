---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import ShaderBackground from '../components/ShaderBackground.astro';
import DecodeHeading from '../components/DecodeHeading.astro';
import OsiStack from '../components/OsiStack.astro';
import { contact } from '../data/contact';

// Empresas donde trabajaron los integrantes del equipo antes de Tecton Labs (no son clientes de Tecton).
const teamExperience = [
    { name: 'TransCore', logo: '/TransCore_Logo_FullColor-1024x262.png', class: 'h-8 sm:h-10' },
    { name: 'BP', logo: '/bp-logo--inspired-business-media-2.png', class: 'h-16 sm:h-20' },
    { name: 'EA Games', logo: '/png-clipart-metrostation-ea-games-logo-thumbnail.png', class: 'h-16 sm:h-20' },
];
---

<Layout>
    <section class="relative overflow-hidden">
        <ShaderBackground />
        <div class="absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/70 to-ink-950"></div>
        <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-24 text-center sm:pt-28">
            <div class="mx-auto mb-8 flex items-center justify-center gap-4 sm:gap-6">
                <img src="/tecton_logo_badge_white_transparency.png" alt="Tecton" class="h-16 w-auto sm:h-24" />
                <img src="/logo_white_stroke_small.png" alt="Tecton Labs" class="h-8 w-auto sm:h-15" />
            </div>
            <DecodeHeading
                id="hero-heading"
                text="De problemas complejos a software simple"
                class="mx-auto max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-6xl"
            />
            <p class="mx-auto mt-6 max-w-2xl text-base text-gray-400 sm:text-lg">
                Diseñamos y construimos software robusto para empresas que necesitan avanzar rápido sin sacrificar calidad.
            </p>
            <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
                <a
                    href="#contacto"
                    class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95"
                >
                    Empecemos un proyecto
                </a>
                <a
                    href="#servicios"
                    class="rounded-full border border-white/15 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/40 active:scale-95"
                >
                    Ver servicios
                </a>
            </div>
        </div>
    </section>

    <section id="servicios" class="relative overflow-hidden border-t border-white/10 bg-white/[0.02] py-24">
        <!-- Glow effect -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/10 via-ink-950/0 to-ink-950/0 pointer-events-none"></div>
        
        <div class="relative mx-auto max-w-7xl px-6">
            <OsiStack />
        </div>
    </section>

    <section id="nosotros" class="py-24">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:grid-cols-2 sm:items-center">
            <div>
                <h2 class="text-3xl font-bold text-white sm:text-4xl">Nosotros</h2>
                <p class="mt-4 text-gray-400">
                    Tecton Labs nació para ayudar a empresas de todos los tamaños a resolver sus desafíos tecnológicos con soluciones pensadas a medida, no con productos genéricos.
                </p>
                <p class="mt-4 text-gray-400">
                    Trabajamos como una extensión de tu equipo: comunicación directa, entregas frecuentes y compromiso con resultados medibles.
                </p>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:gap-6">
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">+10 años</p>
                    <p class="mt-1 text-sm text-gray-400">De experiencia del equipo</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">Semanas</p>
                    <p class="mt-1 text-sm text-gray-400">Hasta la primera entrega, no meses</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">Mendoza</p>
                    <p class="mt-1 text-sm text-gray-400">Reuniones presenciales o remotas</p>
                </div>
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">End to end</p>
                    <p class="mt-1 text-sm text-gray-400">De la infraestructura al producto</p>
                </div>
            </div>
        </div>
    </section>

	

    <section id="experiencia" class="border-t border-white/10 bg-white/[0.02] py-24">
        <div class="mx-auto max-w-6xl px-6 text-center">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">Experiencia del equipo</h2>
            <p class="mx-auto mt-6 max-w-3xl text-gray-400">
                Nuestro equipo trabajó en proyectos para empresas como:
            </p>

            <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-14 gap-y-10">
                {teamExperience.map((company) => (
                    <li>
                        <img
                            src={company.logo}
                            alt={company.name}
                            class={`${company.class} w-auto object-contain opacity-60 brightness-0 invert transition hover:opacity-100`}
                            loading="lazy"
                        />
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section id="contacto" class="py-24 border-t border-white/10 relative overflow-hidden">
        <!-- Glow effect -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/20 via-ink-950/0 to-ink-950/0 pointer-events-none"></div>
        
        <div class="relative mx-auto max-w-6xl px-6">
            <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-start">
                <div>
                    <h2 class="text-3xl font-bold text-white sm:text-4xl">¿Listo para construir?</h2>
                    <p class="mt-4 text-lg text-gray-400 max-w-md">
                        Contanos qué necesitás. Analizamos tu caso y coordinamos una reunión, presencial o por videollamada, para definir el mejor enfoque técnico para tu producto.
                    </p>
                    
                    <div class="mt-10 space-y-6">
                        <!-- Direct Email -->
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                                <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Email directo</p>
                                <a href={`mailto:${contact.email}`} class="text-lg font-semibold text-white transition hover:text-brand-400">{contact.email}</a>
                            </div>
                        </div>

                        <!-- WhatsApp -->
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                                <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">WhatsApp</p>
                                <a href={contact.whatsapp.url} target="_blank" rel="noopener" class="text-lg font-semibold text-white transition hover:text-brand-400">{contact.whatsapp.display}</a>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                                <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Ubicación</p>
                                <p class="text-lg font-semibold text-white">{contact.location}</p>
                                <p class="text-sm text-gray-400">Reuniones presenciales o remotas</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Form Card -->
                <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] p-6 sm:p-8 backdrop-blur-sm">
                    <ContactForm client:load email={contact.email} />
                </div>
            </div>
        </div>
    </section>

</Layout>
