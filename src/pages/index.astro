---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import ShaderBackground from '../components/ShaderBackground.astro';
import DecodeHeading from '../components/DecodeHeading.astro';
import { services } from '../data/services';
---

<Layout>
	<section class="relative overflow-hidden">
		<ShaderBackground />
		<div class="absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/70 to-ink-950"></div>
		<div class="relative mx-auto max-w-6xl px-6 pt-20 pb-24 text-center sm:pt-28">
			<div class="mx-auto mb-8 flex items-center justify-center gap-5 sm:gap-6">
				<img src="/tecton_logo_badge_white_transparency.png" alt="Tecton" class="h-24 w-auto sm:h-30" />
				<img src="/logo_white_stroke_small.png" alt="Tecton Labs" class="h-12 w-auto sm:h-20" />
			</div>
			<DecodeHeading
				id="hero-heading"
				text="De problemas complejos a software simple"
				class="mx-auto max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-6xl"
			/>
			<p class="mx-auto mt-6 max-w-2xl text-base text-gray-400 sm:text-lg">
				En Tecton Labs diseñamos, construimos y mantenemos soluciones de software para empresas
				que necesitan moverse rápido sin sacrificar calidad.
			</p>
			<div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
				<a
					href="#contacto"
					class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95"
				>
					Empecemos un proyecto
				</a>
				<a
					href="#servicios"
					class="rounded-full border border-white/15 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/40 active:scale-95"
				>
					Ver servicios
				</a>
			</div>
		</div>
	</section>

	<section id="servicios" class="border-t border-white/10 bg-white/[0.02] py-24">
		<div class="mx-auto max-w-6xl px-6">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">Servicios</h2>
			<p class="mt-3 max-w-2xl text-gray-400">
				Un equipo multidisciplinario cubriendo todo el ciclo de vida de tu producto, desde la
				idea hasta la operación.
			</p>
			<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-4 sm:grid-rows-2">
				<div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-brand-900/40 via-ink-950 to-ink-950 p-8 sm:col-span-2 sm:row-span-2">
					<span class="font-mono-brand text-sm text-brand-400">01</span>
					<h3 class="mt-4 text-2xl font-bold text-white">{services[0].title}</h3>
					<p class="mt-3 max-w-sm text-gray-400">{services[0].description}</p>
					<div class="mt-8 rounded-2xl border border-white/10 bg-black/40 p-4 font-mono-brand text-xs leading-relaxed text-gray-500" aria-hidden="true">
						<p><span class="text-brand-400">const</span> proyecto = <span class="text-amber-300">"a medida"</span>;</p>
						<p><span class="text-brand-400">function</span> <span class="text-white">construir</span>(necesidad) {'{'}</p>
						<p class="pl-4">return <span class="text-emerald-400">solucion</span>(necesidad);</p>
						<p>{'}'}</p>
					</div>
				</div>

				{services.slice(1).map((service, i) => (
					<div class="group rounded-3xl border border-white/10 bg-white/[0.02] p-6 transition hover:border-brand-500/40 hover:bg-white/[0.04]">
						<span class="font-mono-brand text-sm text-brand-400">{String(i + 2).padStart(2, '0')}</span>
						<h3 class="mt-3 text-lg font-semibold text-white">{service.title}</h3>
						<p class="mt-2 text-sm text-gray-400">{service.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="nosotros" class="py-24">
		<div class="mx-auto grid max-w-6xl gap-12 px-6 sm:grid-cols-2 sm:items-center">
			<div>
				<h2 class="text-3xl font-bold text-white sm:text-4xl">Nosotros</h2>
				<p class="mt-4 text-gray-400">
					Tecton Labs nació para ayudar a empresas de todos los tamaños a resolver sus desafíos
					tecnológicos con soluciones pensadas a medida, no con productos genéricos.
				</p>
				<p class="mt-4 text-gray-400">
					Trabajamos como una extensión de tu equipo: comunicación directa, entregas frecuentes
					y compromiso con resultados medibles.
				</p>
			</div>
			<div class="grid grid-cols-2 gap-4 sm:gap-6">
				<div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
					<p class="text-2xl font-bold text-white sm:text-3xl">+50</p>
					<p class="mt-1 text-sm text-gray-400">Proyectos entregados</p>
				</div>
				<div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
					<p class="text-2xl font-bold text-white sm:text-3xl">+10</p>
					<p class="mt-1 text-sm text-gray-400">Años de experiencia combinada</p>
				</div>
				<div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
					<p class="text-2xl font-bold text-white sm:text-3xl">24/7</p>
					<p class="mt-1 text-sm text-gray-400">Soporte para clientes activos</p>
				</div>
				<div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
					<p class="text-2xl font-bold text-white sm:text-3xl">100%</p>
					<p class="mt-1 text-sm text-gray-400">Foco en resultados</p>
				</div>
			</div>
		</div>
	</section>

	<section id="contacto" class="border-t border-white/10 bg-white/[0.02] py-24">
		<div class="mx-auto max-w-2xl px-6 text-center">
			<h2 class="text-3xl font-bold text-white sm:text-4xl">Hablemos de tu proyecto</h2>
			<p class="mt-3 text-gray-400">
				Contanos qué necesitás y te respondemos con una propuesta a la brevedad.
			</p>
			<div class="mt-10 text-left">
				<ContactForm client:load />
			</div>
		</div>
	</section>
</Layout>
