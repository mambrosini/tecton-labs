---
import ContactForm from '../components/ContactForm';
import ShaderBackground from '../components/ShaderBackground.astro';
import DecodeHeading from '../components/DecodeHeading.astro';
import OsiStack from '../components/OsiStack.astro';
import { contact } from '../data/contact';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

// Empresas donde trabajaron los integrantes del equipo antes de Tecton Labs (no son clientes de Tecton).
const teamExperience = [
    { name: 'TransCore', logo: '/TransCore_Logo_FullColor-1024x262.png', class: 'h-8 sm:h-10' },
    { name: 'BP', logo: '/bp-logo--inspired-business-media-2.png', class: 'h-16 sm:h-20' },
    { name: 'EA Games', logo: '/png-clipart-metrostation-ea-games-logo-thumbnail.png', class: 'h-16 sm:h-20' },
];

const featuredProjects = t.experience.projects.filter((project) => project.featured);
const moreProjects = t.experience.projects.filter((project) => !project.featured);
---

<section class="relative overflow-hidden">
    <ShaderBackground />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/70 to-ink-950"></div>
    <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 text-center sm:pt-28">
        <div class="mx-auto mb-8 flex items-center justify-center gap-4 sm:gap-6">
            <img src="/tecton_logo_badge_white_transparency.png" alt="Tecton" class="h-16 w-auto sm:h-24" />
            <img src="/logo_white_stroke_small.png" alt="Tecton Labs" class="h-8 w-auto sm:h-15" />
        </div>
        <DecodeHeading
            id="hero-heading"
            text={t.hero.title}
            class="mx-auto max-w-4xl text-3xl font-bold tracking-tight text-white sm:text-6xl"
        />
        <p class="mx-auto mt-6 max-w-2xl text-base text-gray-400 sm:text-lg">
            {t.hero.subtitle}
        </p>
        <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
            <a
                href="#contacto"
                class="rounded-full bg-brand-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500 active:scale-95"
            >
                {t.hero.primaryCta}
            </a>
            <a
                href="#servicios"
                class="rounded-full border border-white/15 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/40 active:scale-95"
            >
                {t.hero.secondaryCta}
            </a>
        </div>
        <ul class="mx-auto mt-14 flex max-w-3xl flex-wrap justify-center gap-x-3 gap-y-2 font-[family-name:var(--font-mono-brand)] text-xs text-gray-500 sm:text-sm">
            {t.hero.stack.map((tech, i) => (
                <li class="flex items-center gap-3">
                    {i > 0 && <span class="text-white/20" aria-hidden="true">·</span>}
                    {tech}
                </li>
            ))}
        </ul>
    </div>

    <div class="relative border-t border-white/10">
        <ol class="mx-auto grid max-w-6xl divide-y divide-white/10 px-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            {t.pillars.map((pillar, i) => (
                <li class="py-6 sm:px-8 sm:py-8 sm:first:pl-0 sm:last:pr-0">
                    <p class="font-[family-name:var(--font-mono-brand)] text-xs text-brand-400">0{i + 1}</p>
                    <h2 class="mt-2 text-lg font-bold uppercase tracking-widest text-white">{pillar.title}</h2>
                    <p class="mt-1 text-sm text-gray-400">{pillar.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<section id="servicios" class="relative overflow-hidden border-t border-white/10 bg-white/[0.02] py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/10 via-ink-950/0 to-ink-950/0 pointer-events-none"></div>

    <div class="relative mx-auto max-w-7xl px-6">
        <OsiStack />
    </div>
</section>

<section id="soluciones" class="py-24">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-6 flex items-center gap-4">
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400">{t.problems.eyebrow}</span>
            <div class="h-px w-16 bg-white/20"></div>
        </div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.problems.title}</h2>

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-6">
            {t.problems.items.map((item) => (
                <li class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-6 transition hover:border-brand-500/40 sm:p-8">
                    <p class="text-xl font-bold leading-snug text-white sm:text-2xl">{item.problem}</p>
                    <p class="mt-6 text-xs font-bold uppercase tracking-widest text-brand-400">{item.service}</p>
                    <p class="mt-2 text-gray-400">{item.description}</p>
                </li>
            ))}
        </ul>
    </div>
</section>

<section id="como-trabajamos" class="border-t border-white/10 bg-white/[0.02] py-24">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-6 flex items-center gap-4">
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400">{t.process.eyebrow}</span>
            <div class="h-px w-16 bg-white/20"></div>
        </div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.process.title}</h2>

        <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
            {t.process.steps.map((step, i) => (
                <li class="relative border-t border-white/10 pt-6">
                    <span class="absolute -top-[5px] left-0 h-2.5 w-2.5 rounded-full bg-brand-500"></span>
                    <p class="font-[family-name:var(--font-mono-brand)] text-sm text-brand-400">0{i + 1}</p>
                    <h3 class="mt-2 text-xl font-bold text-white">{step.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-gray-400">{step.description}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

<section id="experiencia" class="border-t border-white/10 py-24">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-6 flex items-center gap-4">
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400">{t.experience.eyebrow}</span>
            <div class="h-px w-16 bg-white/20"></div>
        </div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.experience.title}</h2>

        <ul class="mt-12 grid gap-4 sm:gap-6 md:grid-cols-3">
            {featuredProjects.map((project) => (
                <li class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 sm:p-8">
                    <h3 class="text-xl font-bold text-white sm:text-2xl">{project.title}</h3>
                    <p class="mt-2 font-[family-name:var(--font-mono-brand)] text-xs text-brand-400">{project.meta.join(' · ')}</p>
                    <p class="mt-4 text-gray-400">{project.description}</p>
                </li>
            ))}
        </ul>

        <div class="mt-14 flex items-end justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-white">{t.experience.moreTitle}</h3>
                <p class="mt-1 text-sm text-gray-500 md:hidden">{t.experience.scrollHint} →</p>
            </div>
            <div class="hidden gap-2 md:flex">
                <button type="button" data-projects-scroll="-1" aria-label={t.experience.scrollPrev} class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition hover:border-white/40 disabled:opacity-30">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" data-projects-scroll="1" aria-label={t.experience.scrollNext} class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition hover:border-white/40 disabled:opacity-30">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>
        <ul id="more-projects" class="-mx-6 mt-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(to_right,transparent,black_24px,black_calc(100%-64px),transparent)]">
            {moreProjects.map((project) => (
                <li class="w-72 shrink-0 snap-start rounded-2xl border border-white/10 bg-white/[0.02] p-6">
                    <h4 class="font-bold text-white">{project.title}</h4>
                    <p class="mt-2 font-[family-name:var(--font-mono-brand)] text-[11px] text-brand-400">{project.meta.join(' · ')}</p>
                    <p class="mt-3 text-sm text-gray-400">{project.description}</p>
                </li>
            ))}
        </ul>

        <p class="mt-14 text-center text-gray-400">{t.experience.companiesIntro}</p>
        <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-10">
            {teamExperience.map((company) => (
                <li>
                    <img
                        src={company.logo}
                        alt={company.name}
                        class={`${company.class} w-auto object-contain opacity-60 brightness-0 invert transition hover:opacity-100`}
                        loading="lazy"
                    />
                </li>
            ))}
        </ul>
    </div>
</section>

<section id="nosotros" class="border-t border-white/10 bg-white/[0.02] py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 sm:grid-cols-2 sm:items-center">
        <div>
            <div class="mb-6 flex items-center gap-4">
                <span class="text-xs font-bold uppercase tracking-widest text-gray-400">{t.about.eyebrow}</span>
                <div class="h-px w-16 bg-white/20"></div>
            </div>
            <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.about.title}</h2>
            {t.about.paragraphs.map((paragraph) => (
                <p class="mt-4 text-gray-400">{paragraph}</p>
            ))}
        </div>
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
            {t.about.stats.map((stat) => (
                <div class="rounded-2xl border border-white/10 p-4 text-center sm:p-6">
                    <p class="text-2xl font-bold text-white sm:text-3xl">{stat.value}</p>
                    <p class="mt-1 text-sm text-gray-400">{stat.label}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<section id="contacto" class="relative overflow-hidden border-t border-white/10 py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/20 via-ink-950/0 to-ink-950/0 pointer-events-none"></div>

    <div class="relative mx-auto max-w-6xl px-6">
        <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.contact.title}</h2>
                <p class="mt-4 max-w-md text-lg text-gray-400">{t.contact.subtitle}</p>

                <div class="mt-10 space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                            <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">{t.contact.emailLabel}</p>
                            <a href={`mailto:${contact.email}`} class="text-lg font-semibold text-white transition hover:text-brand-400">{contact.email}</a>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                            <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">{t.contact.whatsappLabel}</p>
                            <a href={contact.whatsapp.url(t.contact.whatsappMessage)} target="_blank" rel="noopener" class="text-lg font-semibold text-white transition hover:text-brand-400">{contact.whatsapp.display}</a>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.02]">
                            <svg class="h-5 w-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-500">{t.contact.locationLabel}</p>
                            <p class="text-lg font-semibold text-white">{contact.location}</p>
                            <p class="text-sm text-gray-400">{t.contact.locationNote}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] p-6 backdrop-blur-sm sm:p-8">
                <ContactForm client:load email={contact.email} labels={t.contact.form} />
            </div>
        </div>
    </div>
</section>

<script>
    const track = document.getElementById('more-projects');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-projects-scroll]');

    function updateButtons() {
        if (!track) return;
        const max = track.scrollWidth - track.clientWidth - 1;
        buttons.forEach((button) => {
            button.disabled = button.dataset.projectsScroll === '-1' ? track.scrollLeft <= 0 : track.scrollLeft >= max;
        });
    }

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            if (!track) return;
            const direction = Number(button.dataset.projectsScroll);
            track.scrollBy({ left: direction * track.clientWidth * 0.8, behavior: 'smooth' });
        });
    });

    track?.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
</script>
