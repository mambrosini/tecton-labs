---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PalettePicker from '../components/PalettePicker.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Tecton Labs — Soluciones informáticas',
	description = 'Tecton Labs desarrolla software a medida, servicios cloud y consultoría IT para impulsar tu negocio.',
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline>
			document.documentElement.dataset.palette = localStorage.getItem('tecton-palette') || 'blue';
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<PalettePicker />
	</body>
</html>
