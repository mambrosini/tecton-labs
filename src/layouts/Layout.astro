---
import '../styles/global.css';
import { contact } from '../data/contact';
import { useTranslations } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PalettePicker from '../components/PalettePicker.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
	title?: string;
	description?: string;
}

const locale = Astro.currentLocale ?? 'es';
const t = useTranslations(locale);

const { title = t.meta.title, description = t.meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const organization = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tecton Labs',
	url: canonical.origin,
	email: contact.email,
	telephone: contact.whatsapp.display,
	areaServed: contact.location,
	address: { '@type': 'PostalAddress', addressLocality: 'Mendoza', addressCountry: 'AR' },
};
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tecton Labs" />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(organization)} />
		<script is:inline>
			// Paletas válidas: ver PalettePicker.astro. Un valor viejo guardado (p. ej. 'blue') cae a la default.
			let palette = 'mclaren';
			try {
				const saved = localStorage.getItem('tecton-palette');
				if (saved === 'mclaren' || saved === 'synthwave') palette = saved;
			} catch {}
			document.documentElement.dataset.palette = palette;
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<WhatsAppButton />
		<PalettePicker />
	</body>
</html>
