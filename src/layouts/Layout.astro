---
import '../styles/global.css';
import { contact } from '../data/contact';
import { defaultLocale, localePath, locales, localeStorageKey, useTranslations, type Locale } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PalettePicker from '../components/PalettePicker.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
	title?: string;
	description?: string;
}

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);

const { title = t.meta.title, description = t.meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
// Imagen para previews al compartir el link (1200x630).
const ogImage = new URL('/links_image.jpg?v=3', Astro.site ?? Astro.url);

// Versiones de la misma página en cada idioma (hreflang), para buscadores.
const alternates = locales.map((alt) => ({ locale: alt, href: new URL(localePath(alt), Astro.site ?? Astro.url) }));
const defaultHref = new URL(localePath(defaultLocale), Astro.site ?? Astro.url);

const organization = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tecton Labs',
	url: canonical.origin,
	email: contact.email,
	telephone: contact.whatsapp.display,
	areaServed: contact.location,
	address: { '@type': 'PostalAddress', addressLocality: 'Mendoza', addressCountry: 'AR' },
};
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={defaultHref} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tecton Labs" />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tecton Labs" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(organization)} />
		<script is:inline define:vars={{ isDefaultLocale: locale === defaultLocale, storageKey: localeStorageKey, enPath: localePath('en') }}>
			// Primera visita a la home en español: si el visitante no está en un país hispanohablante
			// (según la zona horaria del dispositivo) ni tiene el navegador en español, lo llevamos a /en/.
			// Si ya eligió idioma con el selector, se respeta. Los bots no se redirigen (indexan ambas versiones).
			(function () {
				if (!isDefaultLocale) return;
				try {
					if (localStorage.getItem(storageKey)) return;
				} catch {}
				if (/bot|crawl|spider|slurp|preview|lighthouse|facebookexternalhit|whatsapp|telegram/i.test(navigator.userAgent)) return;
				var tz = '';
				try {
					tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
				} catch {}
				var spanishTz = /^(America\/(Argentina|Buenos_Aires|Catamarca|Cordoba|Jujuy|Mendoza|Rosario|Santiago|Punta_Arenas|Montevideo|Asuncion|La_Paz|Lima|Bogota|Guayaquil|Caracas|Mexico_City|Monterrey|Merida|Cancun|Chihuahua|Ciudad_Juarez|Hermosillo|Mazatlan|Tijuana|Matamoros|Ojinaga|Bahia_Banderas|Guatemala|El_Salvador|Tegucigalpa|Managua|Costa_Rica|Panama|Havana|Santo_Domingo|Puerto_Rico)|Europe\/Madrid|Atlantic\/Canary|Africa\/Ceuta|Africa\/Malabo|Pacific\/(Galapagos|Easter))/;
				var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
				var speaksSpanish = langs.some(function (l) { return /^es/i.test(l); });
				if (!spanishTz.test(tz) && !speaksSpanish) location.replace(enPath + location.hash);
			})();
		</script>
		<script is:inline define:vars={{ allowSavedPalette: import.meta.env.DEV }}>
			// En producción la marca es siempre naranja (mclaren); el PalettePicker solo existe en desarrollo.
			// Paletas válidas: ver PalettePicker.astro. Un valor viejo guardado (p. ej. 'blue') cae a la default.
			let palette = 'mclaren';
			try {
				const saved = localStorage.getItem('tecton-palette');
				if (allowSavedPalette && (saved === 'mclaren' || saved === 'synthwave')) palette = saved;
			} catch {}
			document.documentElement.dataset.palette = palette;
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<WhatsAppButton />
		{import.meta.env.DEV && <PalettePicker />}
	</body>
</html>
